# Copy this file to .env.local and fill in real values.
# See docs/google-maps-setup.md, docs/whatsapp-setup.md and
# docs/deployment.md for how to obtain each of these.

# ---------- Database (Supabase Postgres) ----------
# Pooled connection (PgBouncer, port 6543) — used by the app at runtime.
# Supabase dashboard: Project Settings -> Database -> Connection string -> "Transaction" pooler.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (port 5432) — used only by `prisma migrate` / `prisma studio`.
# Supabase dashboard: Project Settings -> Database -> Connection string -> "Direct connection".
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ---------- Supabase Auth ----------
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---------- Google Maps Platform ----------
# Browser key: Maps JavaScript API + Places API, restricted by HTTP referrer to your domain.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server key: Geocoding API + Routes API, restricted by IP/server if possible.
# Leave unset for local development to use the dev-only straight-line
# route fallback (clearly labeled in the UI) — never leave it unset in
# production, where route optimization will refuse to run without it.
GOOGLE_MAPS_SERVER_API_KEY=

# ---------- WhatsApp Cloud API (Meta) ----------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Any string you choose — enter the same value in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=
# App Settings -> Basic -> App Secret.
META_APP_SECRET=

# ---------- Cron ----------
# Any string you choose — used to authenticate Vercel Cron's call to
# /api/cron/generate-daily-orders (Authorization: Bearer <this value>).
CRON_SECRET=

NODE_ENV="development"
