# Copy this file to .env.local and fill in real values.
# See docs/google-maps-setup.md, docs/whatsapp-setup.md and
# docs/deployment.md for how to obtain each of these.

# ---------- Database (Supabase Postgres) ----------
# Pooled connection (PgBouncer, port 6543) — used by the app at runtime.
# Supabase dashboard: Project Settings -> Database -> Connection string -> "Transaction" pooler.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (port 5432) — used only by `prisma migrate` / `prisma studio`.
# Supabase dashboard: Project Settings -> Database -> Connection string -> "Direct connection".
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ---------- Supabase Auth ----------
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---------- Maps, geocoding & routing ----------
# ALL OPTIONAL. Leave everything in this section blank to run entirely on
# FREE, no-key services:
#   - Maps          -> Leaflet + OpenStreetMap tiles (no key)
#   - Geocoding     -> Nominatim / OpenStreetMap    (no key)
#   - Route optim.  -> OSRM public /trip server      (no key, real roads)
# Set the Google keys below only if you specifically prefer Google's map
# tiles / Places Autocomplete / Routes API — the app switches to Google
# automatically when a key is present.

# Google browser key (Maps JavaScript API + Places API), referrer-restricted.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Google server key (Geocoding API + Routes API).
GOOGLE_MAPS_SERVER_API_KEY=

# Optional: point the free routing/geocoding at a self-hosted instance
# instead of the public demo servers (recommended only for heavy use).
# OSRM_BASE_URL=https://router.project-osrm.org
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ---------- WhatsApp Cloud API (Meta) ----------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Any string you choose — enter the same value in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=
# App Settings -> Basic -> App Secret.
META_APP_SECRET=

# ---------- Cron ----------
# Any string you choose — used to authenticate Vercel Cron's call to
# /api/cron/generate-daily-orders (Authorization: Bearer <this value>).
CRON_SECRET=

NODE_ENV="development"

# Alternative for Render: set these instead of DATABASE_URL / DIRECT_URL.
# Enter PGPASSWORD directly into the hosting secret field; never commit it.
# PGHOST=your-project-pooler.supabase.com
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres.your-project-ref
# PGPASSWORD=
